# production file at api.shift2bikes.org:/opt/shift-docs/secrets

export SMTP_HOST=
export SMTP_USER=
export SMTP_PASS=
export SMTP_LOGIN=DIGEST-MD5
export SMTP_DOMAIN=
export CAL_ADMIN_PASSWORD=
# the biiikes_match endpoint is off while this is empty.
# comma separated, so a new token can be added before the old one is removed.
export BIIIKES_MATCH_TOKENS=
# requests per token per clock hour; defaults to 100.
export BIIIKES_MATCH_PER_HOUR=
